        </mxCell>
        <mxCell id="c39" edge="1" parent="1" source="c3" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=3;strokeColor=#6C8EBF;fontSize=10;fontColor=#232F3E;" target="c9" value="entra na pista">
