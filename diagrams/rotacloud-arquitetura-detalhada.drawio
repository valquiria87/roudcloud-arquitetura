<mxCell id="c33" value="&lt;b&gt;BASTIDORES · EQUIPE E TURNOS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Posto 24h em 3 turnos: frentistas, caixas, cozinha e gerência&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#232F3E;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="470" height="150" as="geometry"/></mxCell>
