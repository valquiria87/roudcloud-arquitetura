        </mxCell>
        <mxCell id="c40" edge="1" parent="1" source="c9" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=3;strokeColor=#6C8EBF;fontSize=10;fontColor=#232F3E;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" target="c15" value="paga">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c41" edge="1" parent="1" source="c15" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=3;strokeColor=#6C8EBF;fontSize=10;fontColor=#232F3E;" target="c21" value="vai comer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c42" edge="1" parent="1" source="c21" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=3;strokeColor=#6C8EBF;fontSize=10;fontColor=#232F3E;" target="c27" value="compra ou usa serviços">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c43" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#232F3E;fillColor=#F5F5F5;strokeColor=#666666;" value="&lt;b&gt;Como o cliente passa pelo posto:&lt;/b&gt; 1 chega (carro, moto, caminhão ou ônibus) → 2 abastece (gasolina comum, aditivada, etanol ou diesel S10; caminhão e ônibus usam a pista pesada) → 3 paga no caixa (PIX, cartão ou cartão frota) e recebe a NFC-e → 4 se quiser, come no restaurante (buffet por quilo com balança, à la carte) → 5 usa a loja e os serviços (troca de óleo, calibragem, banho do caminhoneiro) e sai.&lt;br&gt;&lt;br&gt;&lt;b&gt;Turnos:&lt;/b&gt; o posto funciona 24h em 3 turnos (06h–14h, 14h–22h, 22h–06h). Cada funcionário bate o ponto ao entrar e ao sair. No fim do turno, o fechamento de caixa vira um relatório no S3 e o Lambda confere e avisa o gerente.&lt;br&gt;&lt;br&gt;&lt;strong&gt;Expansão:&lt;/strong&gt; cada novo posto pode reutilizar a arquitetura de referência, com recursos EC2, EBS e S3 organizados para sua operação. O planejamento de rede e endereçamento deve considerar cada nova unidade, mantendo a gestão centralizada." vertex="1">
          <mxGeometry height="215" width="1040" x="40" y="705" as="geometry" />
        </mxCell>
