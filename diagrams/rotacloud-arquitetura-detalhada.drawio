<mxCell id="c1" value="&lt;b&gt;&lt;font style='font-size:24px'&gt;RotaCloud: arquitetura multi-posto na AWS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Da chegada do cliente ao fechamento do turno: posto de combustível com restaurante, conveniência e equipe em 3 turnos, rodando em EC2, EBS, S3 e Lambda." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="60" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;POSTO FÍSICO&lt;/b&gt; · jornada do cliente e rotina da equipe" style="rounded=1;arcSize=2;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#FAFAFA;strokeColor=#999999;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1040" height="600" as="geometry"/></mxCell>
